local function createPr()
  vim.ui.input({ prompt = 'Title: ' }, function(title)
    if not title or title == '' then return end
    vim.ui.input({ prompt = 'Body: ' }, function(body)
      if not body or body == '' then return end
      local cmd = { 'gh', 'pr', 'create', '-t', title, '-b', body, '--assignee', '@me' }
      vim.system(cmd, {}, function(result)
        vim.schedule(function()
          if result.code == 0 then
            vim.notify('PR created', vim.log.levels.INFO)
          else
            vim.notify(result.stderr or 'PR creation failed', vim.log.levels.ERROR)
          end
        end)
      end)
    end)
  end)
end

vim.keymap.set('n', '<leader>gP', createPr, { desc = 'Create GitHub Pull Request' })
